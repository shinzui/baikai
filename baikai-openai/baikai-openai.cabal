cabal-version: 3.4
name: baikai-openai
version: 0.1.0.0
synopsis: OpenAI providers for the baikai abstraction
description:
  Wraps the openai Haskell package as a Baikai Provider for OpenAI's Chat Completions API.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Baikai.Provider.OpenAI.Api
    Baikai.Provider.OpenAI.Cli

  build-depends:
    , base >=4.20 && <5
    , aeson
    , baikai
    , base64-bytestring
    , bytestring
    , containers
    , generic-lens
    , http-client
    , http-client-tls
    , lens ^>=5.3
    , openai
    , process
    , servant-client
    , streamly ^>=0.12
    , streamly-core ^>=0.4
    , text ^>=2.1
    , time
    , vector
