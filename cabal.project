packages:
  baikai
  baikai-claude
  baikai-openai
  baikai-smoke
  baikai-trace-otel

-- GHC is provided by the Nix devShell from `nix-haskell-flake` (currently
-- pinned to ghc912). Add a `with-compiler:` line here if you want
-- cabal to fail loudly when the version drifts from the flake.
--
-- All dependencies resolve from Hackage: claude, openai, cradle,
-- hs-opentelemetry-api, hs-opentelemetry-sdk, hs-opentelemetry-exporter-in-memory,
-- and the streamly / streamly-core pair (latest released 0.11 / 0.3).

test-show-details: direct
tests: True

-- Parallel module compilation
jobs: $ncpus
