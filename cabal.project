packages:
  baikai
  baikai-claude
  baikai-openai
  baikai-smoke
  /Users/shinzui/Keikaku/hub/haskell/claude-project/claude
  /Users/shinzui/Keikaku/hub/haskell/openai-project/openai
  /Users/shinzui/Keikaku/hub/haskell/cradle-project/cradle
  /Users/shinzui/Keikaku/hub/haskell/streamly-project/streamly
  /Users/shinzui/Keikaku/hub/haskell/streamly-project/streamly/core

-- GHC is provided by the Nix devShell from `nix-haskell-flake` (currently
-- pinned to ghc912). Add a `with-compiler:` line here if you want
-- cabal to fail loudly when the version drifts from the flake.

test-show-details: direct
tests: True

-- The upstream Mercury packages ship their own live-network tasty suites that
-- expect ANTHROPIC_KEY / OPENAI_KEY to be set. We pull these packages in via
-- `packages:` for their libraries only; disable their test-suites so that
-- `cabal test all` does not try (and fail) to run them.
package claude
  tests: False

package openai
  tests: False

-- The upstream streamly packages also ship live test-suites; library only.
package streamly
  tests: False

package streamly-core
  tests: False

-- cradle's test-suite spawns subprocesses and exercises external state.
-- We only need the library.
package cradle
  tests: False

-- Parallel module compilation
jobs: $ncpus
