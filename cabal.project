packages:
  baikai
  baikai-claude
  baikai-openai
  baikai-smoke
  baikai-trace-otel
  /Users/shinzui/Keikaku/hub/haskell/streamly-project/streamly
  /Users/shinzui/Keikaku/hub/haskell/streamly-project/streamly/core
  /Users/shinzui/Keikaku/hub/haskell/hs-opentelemetry-project/hs-opentelemetry/exporters/in-memory

-- GHC is provided by the Nix devShell from `nix-haskell-flake` (currently
-- pinned to ghc912). Add a `with-compiler:` line here if you want
-- cabal to fail loudly when the version drifts from the flake.
--
-- claude, openai, cradle, hs-opentelemetry-api, and hs-opentelemetry-sdk
-- resolve from Hackage. streamly stays vendored because the local 0.12.x
-- is newer than Hackage's 0.9.x. hs-opentelemetry-exporter-in-memory stays
-- vendored because the on-disk 0.0.1.4 has a local patch loosening
-- `hs-opentelemetry-api ==0.2.*` to `==0.3.*` that has not been released
-- to Hackage; without it the solver cannot reconcile in-memory 0.0.1.4
-- with sdk 0.1.0.1 (which itself requires api 0.3.*).

test-show-details: direct
tests: True

-- The vendored streamly packages ship live tasty suites that we do not
-- want to drag into `cabal test all`. Library only.
package streamly
  tests: False

package streamly-core
  tests: False

-- The vendored in-memory exporter ships a tasty suite we do not want
-- in `cabal test all` either.
package hs-opentelemetry-exporter-in-memory
  tests: False

-- Parallel module compilation
jobs: $ncpus
