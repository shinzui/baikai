packages:
  baikai
  baikai-claude
  baikai-openai
  baikai-smoke
  baikai-trace-otel

source-repository-package
  type: git
  location: https://github.com/shinzui/streamly-project
  tag: f8e33b5600f5ddadc17ce5d9a8e45a16c09899cb
  subdir: streamly

source-repository-package
  type: git
  location: https://github.com/shinzui/streamly-project
  tag: f8e33b5600f5ddadc17ce5d9a8e45a16c09899cb
  subdir: streamly/core

-- GHC is provided by the Nix devShell from `nix-haskell-flake` (currently
-- pinned to ghc912). Add a `with-compiler:` line here if you want
-- cabal to fail loudly when the version drifts from the flake.
--
-- claude, openai, cradle, hs-opentelemetry-api, hs-opentelemetry-sdk, and
-- hs-opentelemetry-exporter-in-memory resolve from Hackage. streamly and
-- streamly-core are pinned to GitHub because the project depends on the
-- unreleased 0.12/0.4 package pair.

test-show-details: direct
tests: True

-- The vendored streamly packages ship live tasty suites that we do not
-- want to drag into `cabal test all`. Library only.
package streamly
  tests: False

package streamly-core
  tests: False

-- Parallel module compilation
jobs: $ncpus
