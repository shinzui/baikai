cabal-version: 3.4
name: baikai
version: 0.1.0.0
synopsis: baikai provides a unified Haskell interface for working with multiple AI providers.
description:
  baikai provides a unified Haskell interface for working with multiple AI providers.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple
extra-doc-files: ../CHANGELOG.md

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Baikai
    Baikai.Auth
    Baikai.Content
    Baikai.Cost
    Baikai.Cost.Log
    Baikai.Cost.Pricing
    Baikai.Error
    Baikai.Message
    Baikai.Model
    Baikai.Prelude
    Baikai.Provider
    Baikai.Provider.Cli.Internal
    Baikai.Request
    Baikai.Response
    Baikai.StopReason
    Baikai.Trace
    Baikai.Trace.Event
    Baikai.Trace.Sink
    Baikai.Usage

  build-depends:
    base >=4.20 && <5,
    aeson,
    base64-bytestring,
    bytestring,
    containers,
    generic-lens,
    lens ^>=5.3,
    scientific,
    streamly ^>=0.12,
    streamly-core ^>=0.4,
    text ^>=2.1,
    time,
    unliftio-core,
    vector,

test-suite baikai-test
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    CostSpec
    TraceSpec
  build-depends:
    base,
    aeson,
    baikai,
    bytestring,
    directory,
    filepath,
    stm,
    streamly-core ^>=0.4,
    tasty,
    tasty-hunit,
    text,
    vector,
