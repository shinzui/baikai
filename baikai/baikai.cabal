cabal-version: 3.4
name: baikai
version: 0.1.0.0
synopsis: baikai provides a unified Haskell interface for working with multiple AI providers.
description:
  baikai provides a unified Haskell interface for working with multiple AI providers.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple
extra-doc-files: ../CHANGELOG.md

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Baikai
    Baikai.Prelude

  build-depends:
    base >=4.20 && <5,
    generic-lens,
    lens ^>=5.3,
    text ^>=2.1,
